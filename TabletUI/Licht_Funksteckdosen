<li data-row="2" data-col="5" data-sizex="2" data-sizey="2">
<div data-type="homestatus"
     data-device="HomeStatus" data-get="state" data-get-on='["home_home","home_work","away","holiday"]'
	 data-alias='["Freier Tag","Arbeitstag","Ausgeflogen"," "]'
	 data-icons='["fa-home","fa-industry","fa-suitcase",""]'></div>
</li>

<li data-row="5" data-col="5" data-sizex="1" data-sizey="1"> 
<header><div data-type="label" class="large">aktueller Homestatus</div></header> 
<div data-type="label" data-device="HomeStatus" data-get="state" data-get-on='["home","night","away","holiday"]'></div> 
</li>



<li data-row="5" data-col="6" data-sizex="1" data-sizey="1"> 
<div data-type="push" 
     data-device="Garage_Taster"
     data-get="zustand" 
     data-states='["on","closed","move","open","absent"]'
     data-colors='["bg-gray","green","yellow","red","#505050"]'
     date-set="on"
     data-background-icon=""
     data-icons='["oa-fts_garage_door_100","oa-fts_garage_door_100","oa-fts_garage_door_50 blink","oa-fts_garage","oa-fts_garage"]'
     class="big"></div>
     <div data-type="label" class="">Garage</div>
</div>    
                                   
<div data-type="popup"
     data-width="200px"
     data-height="200px"
     data-left="600px"
     data-top="300px"
     data-mode="fade"
     data-device="Garage_Taster"
     data-get="state"
     data-get-on="on"
     data-get-off="wait">
               <div class="dialog">
               <header><font size="+1">Garage</font></header>
                    <div class="top-space-3x">
                    <div data-type="push"
                    data-device="Garage_Taster"
                    data-set-on="toggle"
                    data-set-off="wait"
                    data-get="zustand"
                    data-states='["closed","open","absent"]'
                    data-colors='["green","red","#505050"]'
                    data-icons='["oa-fts_garage_door_100","oa-fts_garage","oa-fts_garage"]'                                 
                    data-background-icon="fa-square-o"
                    data-on-background-color="#505050" 
                    class="big"></div>             
               </div>     
     </div>    
</div>   
</li> 




</ul> 
