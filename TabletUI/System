 <li data-row="1" data-col="8" data-sizex="1" data-sizey="4" data-template="menu_right_main.html"></li> 

<li data-row="1" data-col="6" data-sizex="1" data-sizey="3"> 
<header><div data-type="label" class="large">aktuelle Parameter</div></header> 
<div>Luxwert Süd</div>
<div data-type="label" data-device="Helligkeitswert"></div> 
<div>Luxwert GZ</div>
<div data-type="label" data-device="Helligkeitswert2"></div> 
<div>Luxwert WZ</div>
<div data-type="label" data-device="Helligkeitswert3"></div> 
<div>Temperaturwert</div>
<div data-type="label" data-device="Temperaturwert"></div> 
<div>Temperaturwert WZ</div>
<div data-type="label" data-device="TemperaturwertWZ"></div> 
<div>ExtremTemperatur</div>
<div data-type="label" data-device="ExtremTemperatur"></div> 
<div>RolloUp Werktag</div>
<div data-type="label" data-device="RolloUpWT"></div> 
<div>RolloUp Frei</div>
<div data-type="label" data-device="RolloUpFT"></div> 
<div>RolloUp WE</div>
<div data-type="label" data-device="RolloUpWE"></div> 
<div>RolloDown</div>
<div data-type="label" data-device="RolloDown"></div> 
<div>RolloDown WZ</div>
<div data-type="label" data-device="RolloDownWZ"></div> 
</li>

<li data-row="1" data-col="5" data-sizex="1" data-sizey="1"> 
<header><div data-type="label" class="large">aktuelle Werte</div></header> 
<div>Luxwert</div>
<div data-type="label" data-device="Sonnensensor1" data-get="brightness"></div> 
<div>Temperaturwert</div>
<div data-type="label" data-device="AussenTempSens1_T1" data-get="temperature"></div> 
<div>Modus</div>
<div data-type="label" data-device="Moduswahl"></div> 
</li>

<li data-row="2" data-col="5" data-sizex="1" data-sizey="1">
	<header><div data-type="label" class="large">Timer GartenWasser</div></header> 
	<div>
		<div data-type="select"
			data-device="WasserAutoOffTimer"
			data-set=""
			data-alias='["1","5","10","15","20","25","30","35","40"]'
			data-items='["60","300","600","900","1200","1500","1800","2100","2400"]'
		</div>
	</div>
</li>
 
<li data-row="1" data-col="2" data-sizex="1" data-sizey="1">
	<header><div data-type="label" class="large">Lux Rolladen S&uuml;dseite</div></header> 
	<div>
	<!--	<div data-type="label" data-device="Helligkeitswert"></div> -->
