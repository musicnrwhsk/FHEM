	</div>  
</li>	
<li data-row="2" data-col="2" data-sizex="1" data-sizey="1">
	<header><div data-type="label" class="large">Rolladen Temperaturwert</div></header> 
	<div>
	<!--	<div data-type="label" data-device="Temperaturwert"></div> -->
