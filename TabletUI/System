			data-device="ExtremTemperatur"
			data-set=""
			data-items='["20","25","28","30","32"]'  
		</div>
	</div>
</li>

<li data-row="2" data-col="4" data-sizex="1" data-sizey="1">
	<header><div data-type="label" class="large">Rolladen WZ Temperatur</div></header> 
	<div>
