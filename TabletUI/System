			data-set=""
			data-items='["5000","10000","15000","20000","25000","30000","35000","40000"]'
		</div>
	</div>  
</li>
<li data-row="1" data-col="4" data-sizex="1" data-sizey="1">
	<header><div data-type="label" class="large">Lux Rolladen Wohnzimmer</div></header> 
	<div>
